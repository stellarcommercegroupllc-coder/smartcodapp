SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_orders,write_orders,read_draft_orders,write_draft_orders,read_products,write_discounts,read_customers,write_customers,read_themes
SHOPIFY_APP_URL=https://your-app-url.com
# Optional: once published, your listing URL (e.g.
# https://apps.shopify.com/smart-cod) — used as the "Install" link on the
# public landing page at "/". Falls back to "#" if unset.
SHOPIFY_APP_STORE_URL=
DATABASE_URL="postgresql://user:password@host:5432/dbname"
# For local dev without a real Postgres instance, run one in Docker:
#   docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=dev postgres:16
# then use: postgresql://postgres:dev@localhost:5432/postgres
NODE_ENV=development
